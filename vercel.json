{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/config/:key*", "destination": "/api/config?key=:key*" },
    { "source": "/api/config", "destination": "/api/config" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
