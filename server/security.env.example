# Server-only configuration. Never copy these names into VITE_* variables.
# Copy values into server/.env or your process manager's protected environment.
NODE_ENV=production
DATABASE_URL=
SESSION_SECRET=
ADMIN_TOTP_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://chalapathiuniversity.edu.in/api/auth/google/callback
PUBLIC_ORIGINS=https://chalapathiuniversity.edu.in
# Initial provisioning uses the trusted operator CLI, not frontend constants.
# ADMIN_INITIAL_PASSWORD and ADMIN_INITIAL_EMAIL are only for a brand-new empty installation.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
